{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Total anomalies",
      "id": 1,
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres-anomalies"},
      "targets": [{"refId": "A", "rawSql": "SELECT count(*) AS value FROM anomalies WHERE $__timeFilter(detected_at)", "format": "table"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 10}]}}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "High severity",
      "id": 2,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres-anomalies"},
      "targets": [{"refId": "A", "rawSql": "SELECT count(*) AS value FROM anomalies WHERE severity = 'HIGH' AND $__timeFilter(detected_at)", "format": "table"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed"}}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Affected servers",
      "id": 3,
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres-anomalies"},
      "targets": [{"refId": "A", "rawSql": "SELECT count(DISTINCT server) AS value FROM anomalies WHERE $__timeFilter(detected_at)", "format": "table"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
      "fieldConfig": {"defaults": {}, "overrides": []}
    },
    {
      "type": "stat",
      "title": "Latest ML score",
      "id": 4,
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres-anomalies"},
      "targets": [{"refId": "A", "rawSql": "SELECT ml_score AS value FROM anomalies ORDER BY detected_at DESC LIMIT 1", "format": "table"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
      "fieldConfig": {"defaults": {}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Anomaly metrics over time",
      "id": 5,
      "gridPos": {"h": 9, "w": 14, "x": 0, "y": 4},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres-anomalies"},
      "targets": [{"refId": "A", "rawSql": "SELECT detected_at AS time, cpu, mem, resp_ms FROM anomalies WHERE $__timeFilter(detected_at) ORDER BY detected_at", "format": "time_series"}],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "auto", "spanNulls": false}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "timeseries",
      "title": "Anomalies by severity",
      "id": 6,
      "gridPos": {"h": 9, "w": 10, "x": 14, "y": 4},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres-anomalies"},
      "targets": [{"refId": "A", "rawSql": "SELECT date_trunc('minute', detected_at) AS time, severity, count(*) AS anomalies FROM anomalies WHERE $__timeFilter(detected_at) GROUP BY 1, 2 ORDER BY 1", "format": "time_series"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "table",
      "title": "Recent detected anomalies",
      "id": 7,
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 13},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "postgres-anomalies"},
      "targets": [{"refId": "A", "rawSql": "SELECT detected_at, server, severity, round(cpu::numeric, 1) AS cpu, round(mem::numeric, 1) AS mem, failed_logins, round(resp_ms::numeric, 1) AS resp_ms, error_count, round(ml_score::numeric, 3) AS ml_score, rule_violations FROM anomalies WHERE $__timeFilter(detected_at) ORDER BY detected_at DESC LIMIT 50", "format": "table"}],
      "options": {"footer": {"show": false}, "showHeader": true},
      "fieldConfig": {"defaults": {}, "overrides": []}
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["anomaly", "postgres", "logs"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "IT Log Anomaly Monitoring",
  "uid": "log-anomaly-monitoring",
  "version": 1
}
